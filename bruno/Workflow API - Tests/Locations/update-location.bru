meta {
  name: POST Update Worker Location
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/locations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "project_id": "{{projectId}}",
    "lat": 48.1486,
    "lng": 17.1077,
    "is_online": true
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

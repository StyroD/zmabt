meta {
  name: POST Create Task
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "project_id": "{{projectId}}",
    "title": "Vymena rozvodov",
    "description": "Replace water pipes",
    "priority": "high",
    "status": "pending",
    "deadline": "2026-06-01"
  }
}

script:after-response {
  bru.setEnvVar("taskId", res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

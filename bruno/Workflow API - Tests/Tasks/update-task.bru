meta {
  name: PUT Update Task
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "title": "Updated Task Title",
    "priority": "medium"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

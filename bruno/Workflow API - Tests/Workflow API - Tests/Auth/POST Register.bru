meta {
  name: POST Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testworker",
    "email": "testworker@workflow.com",
    "password": "password123",
    "role": "worker",
    "first_name": "Test",
    "last_name": "Worker"
  }
}

script:post-response {
  test("Status code is 201", function () { expect(res.getStatus()).to.equal(201); });
}

settings {
  encodeUrl: true
}

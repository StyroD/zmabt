meta {
  name: GET All Users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status code is 200", function () { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
}

meta {
  name: GET User by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/{{userId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status code is 200", function () { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
}

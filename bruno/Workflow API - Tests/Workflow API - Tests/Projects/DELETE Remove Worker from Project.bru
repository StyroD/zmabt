meta {
  name: DELETE Remove Worker from Project
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/projects/{{projectId}}/workers/{{userId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status is 200 or 404", function () { expect(res.getStatus()).to.be.oneOf([200, 404]); });
}

settings {
  encodeUrl: true
}

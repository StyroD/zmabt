meta {
  name: GET Tasks by Project
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks/project/{{projectId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status code is 200", function () { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
}

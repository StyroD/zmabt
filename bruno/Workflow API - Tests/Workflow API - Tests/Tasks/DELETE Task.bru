meta {
  name: DELETE Task
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status code is 200", function () { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
}

meta {
  name: GET Tasks by Worker
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/tasks/worker/{{userId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{authToken}}
}

script:post-response {
  test("Status code is 200", function () { expect(res.getStatus()).to.equal(200); });
}

settings {
  encodeUrl: true
}
